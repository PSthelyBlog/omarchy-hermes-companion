[Unit]
Description=Hermes Companion — screen-aware voice assistant
After=graphical-session.target pipewire.service
PartOf=graphical-session.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=@HERMES_DIR@
Environment=PYTHONUNBUFFERED=1
Environment=HERMES_AGENT_DIR=@HERMES_DIR@
# Started on the system Python on purpose. The daemon imports Hermes's bootstrap, which re-executes
# it on the Python Hermes manages and leases the dependency environment Hermes committed, so an
# update never pulls that environment out from under a running daemon. Both change on Hermes
# updates, so neither is written here.
# HERMES_SUPERVISED_CHILD is the marker Hermes puts in its own systemd units: a restart after a
# half-finished update leaves finishing it to `hermes update` instead of redoing it on every start.
Environment=HERMES_SUPERVISED_CHILD=1
# -u, not just PYTHONUNBUFFERED: the re-exec runs Python isolated (-I), which drops PYTHON* variables
# but keeps interpreter flags.
ExecStart=/usr/bin/python3 -u @PLUGIN_DIR@/daemon/companion.py
Restart=on-failure
RestartSec=5
MemoryMax=6G
Nice=5

[Install]
WantedBy=graphical-session.target
